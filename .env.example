# ============================================================================
# BitacorIA (sitio www) — variables de entorno públicas
# ============================================================================
# Copia este archivo a .env.local y rellena los valores. Ninguna de estas
# variables es secreta: las NEXT_PUBLIC_* viajan al navegador.
# Las claves privadas (SUPABASE_SERVICE_ROLE_KEY para /admin) se documentan
# en .env.local.example y NUNCA se commitean.
# ============================================================================

# URL de la app (cuenta, pago y producto). El sitio solo enlaza hacia allá:
# /auth para iniciar sesión y /auth?mode=register&plan=... para el alta.
# Con una sesión abierta en la app (cookie de aviso bitacoria_cuenta, que
# escribe la app), src/middleware.ts manda "/" a <APP>/dashboard y la barra
# ofrece "Acceder" (<APP>/dashboard) y el círculo de cuenta con "Cerrar
# sesión" (<APP>/auth/salir).
# Sin barra final. En Vercel (proyecto pagina-informativa) debe ser la de
# producción. En local, con la app en :3000 y este sitio en :3002
# (npx next dev -p 3002), va en .env.local:
#   NEXT_PUBLIC_APP_URL=http://localhost:3000
# En localhost las cookies no distinguen puerto: la cookie de aviso que
# escribe la app en :3000 también llega a :3002, así que la prueba es real.
NEXT_PUBLIC_APP_URL=https://app.bitacoria.com

# Opcional. Hosts extra de los que se acepta la foto de perfil que trae la
# cookie de aviso (campo f), separados por comas; "*.dominio" vale para sus
# subdominios. Sin ella solo se aceptan lh3.googleusercontent.com y
# *.googleusercontent.com, y siempre en https. Debe coincidir con la de la app.
# NEXT_PUBLIC_AVATAR_HOSTS=

# WhatsApp de ventas: código de país + número, SOLO dígitos.
# Ej. México 55 1234 5678 -> 525512345678
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase del SITIO: la URL la usan el boletín del pie de página y
# /admin/leads; la anon key solo el boletín (es pública por diseño). Es OTRO
# proyecto que el de la app, y www no autentica a nadie: la sesión vive allá.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
