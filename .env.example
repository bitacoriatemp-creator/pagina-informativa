# ============================================================================
# BitacorIA (sitio www) — variables de entorno públicas
# ============================================================================
# Copia este archivo a .env.local y rellena los valores. Ninguna de estas
# variables es secreta: las NEXT_PUBLIC_* viajan al navegador.
# Las claves privadas (SUPABASE_SERVICE_ROLE_KEY para /admin) se documentan
# en .env.local.example y NUNCA se commitean.
# ============================================================================

# URL de la app (cuenta, pago y producto). El sitio solo enlaza hacia allá:
# /auth para iniciar sesión y /auth?mode=register&plan=... para el alta.
# Sin barra final. En Vercel (proyecto pagina-informativa) debe ser la de
# producción; en local puede apuntar a http://localhost:3000.
NEXT_PUBLIC_APP_URL=https://app.bitacoria.com

# WhatsApp de ventas: código de país + número, SOLO dígitos.
# Ej. México 55 1234 5678 -> 525512345678
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Solicitud de demo de /registro (tanda 4 del plan registro_filtro, 2026-11-13).
# Las DOS son públicas (viajan al navegador; no son secretos). Con las dos,
# el navegador manda la hoja a
#   {NEXT_PUBLIC_API_BASE_URL}/api/v1/public/demo-requests
# con la verificación de Cloudflare (acción "demo"). Si falta cualquiera de
# las dos, o si el recuadro de verificación no carga, /registro trabaja como
# en la tanda 0: arma el mensaje y abre WhatsApp en el mismo clic.
# En Vercel (proyecto pagina-informativa, Production) se dan de alta con OK de
# Luis y SOLO después de publicar el servidor que recibe (pilot-v55): antes,
# cada solicitud terminaría en "No pudimos guardar tu solicitud".
# Ojo con Preview: el servidor solo acepta el origen www y la llave solo los
# dominios dados de alta en Cloudflare; un Preview con estas variables cae a
# "No pudimos guardar" o a WhatsApp directo.
#
# API de BitacorIA, sin barra final: en producción con https; en local puede
# ser http://localhost:8000.
NEXT_PUBLIC_API_BASE_URL=
# Llave PÚBLICA del sitio en Cloudflare Turnstile (la misma de la app).
# Llaves de prueba para local (nunca en producción):
#   1x00000000000000000000AA siempre pasa · 2x00000000000000000000AB siempre bloquea
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Supabase del SITIO: la URL la usan el boletín del pie de página y
# /admin/leads; la anon key solo el boletín (es pública por diseño). Es OTRO
# proyecto que el de la app, y www no autentica a nadie: la sesión vive allá.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reseñas de usuarios en la portada (JC 2026-09-25). Variable DE SERVIDOR
# (sin NEXT_PUBLIC_: no es secreta, pero tampoco viaja al navegador): la
# página la lee al generarse, con caché de 5 minutos, desde
# {RESENAS_API_URL}/api/v1/public/reviews. Sin ella, sin endpoint o con
# 0 reseñas publicadas, la sección no existe en el HTML; aparece desde la
# primera (JC 2026-10-02: cada reseña se publica sola al enviarse y el
# super admin puede ocultarla después; antes pedía 5 y caché de 1 h). En Vercel
# (proyecto www) es la API de producción, sin barra final; en local puede
# apuntar a http://localhost:8000.
RESENAS_API_URL=

# Solo diseño local: "true" pinta la sección con los datos de ejemplo de
# src/lib/resenasDemo.ts sin backend. Se ignora con NODE_ENV=production;
# nunca en Vercel.
RESENAS_DEMO=
