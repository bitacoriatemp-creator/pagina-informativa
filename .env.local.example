# ============================================================================
# BitacorIA — variables de entorno LOCALES (no se commitean)
# ============================================================================
# Copia este archivo a .env.local y rellena los valores reales.
#   cp .env.local.example .env.local
#
# El dashboard admin en /admin/leads necesita SUPABASE_SERVICE_ROLE_KEY para
# poder leer la tabla `participantes` (RLS está bloqueado para anon).
#
# Cómo obtener el service_role key:
#   1. https://supabase.com/dashboard/project/epjfqcndxoyrtrmasuvt/settings/api
#   2. Sección "Project API keys"
#   3. Botón "Reveal" en la fila "service_role"  (NUNCA exponer al cliente)
#   4. Copia y pega abajo
# ============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://epjfqcndxoyrtrmasuvt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PEGAR_AQUI_EL_SERVICE_ROLE_KEY


# WhatsApp de ventas: codigo de pais + numero, SOLO digitos.
# Ej. Mexico 55 1234 5678 -> 525512345678
NEXT_PUBLIC_WHATSAPP_NUMBER=PEGAR_AQUI_EL_NUMERO
